# .env にコピーして値を入れてください（.env はGitにコミットされません）

# ローカルのPostgreSQL（docker compose で起動するもの）
DATABASE_URL="postgresql://overtime:overtime@localhost:5432/overtime?schema=public"

# Auth.js の署名鍵。`npx auth secret` または `openssl rand -base64 32` で生成
AUTH_SECRET="ここに生成した値"

# Google OAuth クライアント（Google Cloud Console > APIとサービス > 認証情報）
# 承認済みのリダイレクトURI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ログインを許可するドメイン（複数はカンマ区切り 例: "kenzo.tech,gmail.com"）
ALLOWED_DOMAIN="kenzo.co.jp"

# 初期データで管理者として登録するあなたのGoogleアドレス
SEED_ADMIN_EMAIL="you@kenzo.co.jp"
SEED_ADMIN_NAME="管理者"

# 開発用ログイン（Googleの設定前に、登録済み社員を選んでログインできる）
# 本番（NODE_ENV=production）では、この値に関係なく無効になります
DEV_LOGIN="true"

# 承認・却下のメール通知（任意）。SMTP_HOST が空ならメールは送らず、ログに出すだけ
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
